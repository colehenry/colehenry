# Neon pooled connection string, e.g.
# postgresql+psycopg://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Long random string: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=

# The allowlist. Only this Google account can log in.
OWNER_EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dedicated Fernet key for encrypted Calendar/Gmail refresh tokens:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Production values. For local dev use:
#   OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
#   COOKIE_DOMAIN=            (empty — host-only cookie on localhost)
#   FRONTEND_ORIGIN=http://localhost:3000
OAUTH_REDIRECT_URI=https://api.colehenry.dev/auth/google/callback
COOKIE_DOMAIN=.colehenry.dev
FRONTEND_ORIGIN=https://colehenry.dev

# --- Language tool (all optional; features degrade gracefully when unset) ---

# Server TTS voices (Google Cloud TTS synthesizes, Cloudinary caches the mp3s).
# BOTH must be set or audio falls back to browser speech synthesis.
GOOGLE_TTS_API_KEY=
CLOUDINARY_URL=

# LLM fallback for wiki lookups + card enrichment (OpenRouter).
LLM_BASE_URL=https://openrouter.ai/api/v1
OPEN_ROUTER_API_KEY=
MULTILINGUAL_MODEL=
FALLBACK_MODEL=

# --- Brain (/brain second-brain vault; all optional) ---
# Private Obsidian vault repo synced via git; server reads it with a
# fine-grained PAT (contents:read). Chat reuses OPEN_ROUTER_API_KEY above.
BRAIN_REPO=                 # e.g. colehenry/brain
BRAIN_GITHUB_TOKEN=         # fine-grained PAT, contents:read on the vault repo
BRAIN_WEBHOOK_SECRET=       # shared secret for the GitHub push webhook (HMAC)
BRAIN_CHAT_MODEL=           # default OpenRouter slug; UI picker overrides
# Web search tool (Tavily). Set the key to enable web_search for the agent.
# Free tier ~1,000 searches/month. Get a key at tavily.com (tvly-...).
BRAIN_TAVILY_KEY=

# Read-only source-code + history tools. Use a separate fine-grained GitHub PAT
# with Contents: read-only, Pull requests: read-only, and Metadata: read-only on
# exactly these repositories.
BRAIN_CODE_REPOS=colehenry/colehenry,colehenry/lapwise.dev
BRAIN_CODE_GITHUB_TOKEN=

# Read-only Railway deployment + bounded log visibility. Create one project
# token per production environment and copy that service's ID from Railway.
# Project/environment IDs are discovered from the token; no account token is needed.
BRAIN_RAILWAY_COLEHENRY_TOKEN=
BRAIN_RAILWAY_COLEHENRY_SERVICE_ID=
BRAIN_RAILWAY_LAPWISE_TOKEN=
BRAIN_RAILWAY_LAPWISE_SERVICE_ID=
