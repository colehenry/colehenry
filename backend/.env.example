# Neon pooled connection string, e.g.
# postgresql+psycopg://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Long random string: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=

# The allowlist. Only this Google account can log in.
OWNER_EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production values. For local dev use:
#   OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
#   COOKIE_DOMAIN=            (empty — host-only cookie on localhost)
#   FRONTEND_ORIGIN=http://localhost:3000
OAUTH_REDIRECT_URI=https://api.colehenry.dev/auth/google/callback
COOKIE_DOMAIN=.colehenry.dev
FRONTEND_ORIGIN=https://colehenry.dev

# --- Language tool (all optional; features degrade gracefully when unset) ---

# Server TTS voices (Google Cloud TTS synthesizes, Cloudinary caches the mp3s).
# BOTH must be set or audio falls back to browser speech synthesis.
GOOGLE_TTS_API_KEY=
CLOUDINARY_URL=

# LLM fallback for wiki lookups the dictionary misses (phrases, slang).
# Any OpenAI-compatible /chat/completions endpoint works. Examples:
#   OpenAI:    LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#   Anthropic: LLM_BASE_URL=https://api.anthropic.com/v1     LLM_MODEL=claude-haiku-4-5   (or claude-opus-4-8)
#   OpenRouter:LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=<any model slug>
#   Groq:      LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   Ollama:    LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.2  (LLM_API_KEY=ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
